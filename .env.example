# Inbox that should receive quote requests.
# Required. The form shows an error and does not pretend to send if this is empty.
#
# The default sender is Mac Daddy Digital <onboarding@resend.dev>, which Resend
# only delivers to the email address on the Resend account. To deliver to any
# other inbox, verify a domain in Resend and set CONTACT_FROM_EMAIL to an
# address on that domain.
CONTACT_TO_EMAIL=

# Already used in production. Create one at https://resend.com if you are setting
# this up from scratch.
RESEND_API_KEY=

# Optional sender. Example shape: Mac Daddy Digital <you@your-verified-domain>
CONTACT_FROM_EMAIL=
